# Только то, что не может проверить PHP: раздача готового кэша и редиректы.
# Всё остальное (валидация пути, 404, 503) делает index.php — так сайт остаётся
# рабочим, даже если mod_rewrite на хостинге окажется выключен.
Options -Indexes -MultiViews
DirectoryIndex index.php

# Dotfiles (.ftp-deploy-sync-state.json, .env) и маркер схемы наружу не отдаются.
<FilesMatch "^(\.|http-only\.txt$)">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # дубли главной: /index.html и /home ведут на /
  RewriteRule ^index\.html$ / [R=301,L]
  RewriteRule ^home$ / [R=301,L]

  # слэш на конце убираем до кэша
  RewriteCond %{REQUEST_URI} !^/$
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # http -> https только вне localhost: не ломать локальную проверку и reverse-proxy.
  # Сайт, настроенный на http (SITE_URL начинается с http://), получает в корне файл
  # http-only.txt от deploy.yml — тогда редиректа нет и canonical тоже http.
  RewriteCond %{DOCUMENT_ROOT}/http-only.txt !-f
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} !^localhost
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # служебное закрыто; внутренний rewrite кэша не задеваем.
  # REDIRECT_CACHE_HIT: после внутреннего редиректа Apache префиксует переменные
  # окружения, поэтому на втором проходе ENV:CACHE_HIT уже не видно.
  # исключение — прогрев: деплой вызывает его по HTTP (SSH и cron нет),
  # доступ закрыт токеном внутри скрипта
  RewriteCond %{ENV:REDIRECT_CACHE_HIT} !=1
  RewriteCond %{REQUEST_URI} !^/scripts/warmup\.php$
  RewriteRule ^(?:cache|data|lib|scripts|templates|partials)/ - [F]

  # быстрый путь для главной: не гонять / через PHP каждый раз
  RewriteCond %{DOCUMENT_ROOT}/cache/home.html -f
  RewriteRule ^$ cache/home.html [L,E=CACHE_HIT:1]

  # быстрый путь: готовый HTML из кэша, без PHP
  RewriteCond %{DOCUMENT_ROOT}/cache/$1.html -f
  RewriteRule ^([a-z0-9-]+(?:/[a-z0-9-]+)*)$ cache/$1.html [L,E=CACHE_HIT:1]

  # всё остальное — роутеру
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L]
</IfModule>

# Скопируйте в .env и заполните. На хостинге те же переменные задаются в панели сайта.
MAIL_TO=
# По умолчанию no-reply@домен сайта. Задавайте ящиком на своём домене.
MAIL_FROM=
MAIL_SUBJECT_PREFIX=

# Адрес сайта для canonical и sitemap. Пусто — используется http://localhost:8000.
SITE_URL=
# Префикс путей: на проде пусто, на стенде его подставляет workflow.
SITE_BASE=
# Токен прогрева кэша. Пусто — HTTP-режим warmup.php выключен.
WARMUP_TOKEN=
